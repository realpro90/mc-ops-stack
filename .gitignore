# --- secrets (never commit) ---
/secrets/forwarding.secret
/secrets/rcon.secret
.env

# --- local-only compose overrides (e.g. temporary resource trims) ---
compose.override.yml
compose.override.yaml

# --- runtime data: worlds, logs, live config, server jars (bind-mounted /data) ---
servers/*/data/

# --- plugin jars/configs: bind-mounted separately at /data/plugins ---
servers/*/plugins/

# --- backup archives written by the mc-backup sidecars ---
/backups/

# TeenFounders custom ignores
*.py
*.backup*
*.before-*
*.tmp.jar
*.mv.db
*.db
.env*
.npc-*
.tf-*
.*-build/
gradle-*/
plugin-downloads/
proxy/plugins/*.jar
servers/*/plugins/**/*.jar
servers/*/plugins/**/libs/
servers/*/plugins/**/cache/
servers/*/plugins/**/logs/
